USERMAIL="your-email@gmail.com"
# Email app password
PASSWORD="your-app-password"

# Database: defaults to a local SQLite file (./aurora.db) — no setup needed.
# Only set DATABASE_URL if you want a different async SQLAlchemy database.
# DATABASE_URL="sqlite+aiosqlite:///./aurora.db"

# Secret key for JWT token generation (generate a secure random string)
SECRET_KEY="your-secret-key-here"

# Frontend base URL used to build password-reset / verify-email links in emails.
# Must match where the Vite dev server runs (default below).
FRONTEND_URL="http://localhost:3000"

HF_TOKEN="hf_your_token_here"
